{
  "manifest_version": 3,
  "name": "CPE Distancia Puertas",
  "description": "Calcula distancia por censo entre chapa usuario y puertas LAB/FES/NOC/NOC-FES en el chapero.",
  "version": "1.1.0",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://portal.cpevalencia.com/*"
  ],
  "action": {
    "default_title": "CPE Distancia Puertas",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://portal.cpevalencia.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
